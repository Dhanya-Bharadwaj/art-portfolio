# Copy this file to ".env" for running on your own computer.
# On Vercel, add the same names under Settings > Environment Variables instead.
# Real values never go into GitHub.

# --- general ---
FRONTEND_ORIGIN=http://localhost:5173
USE_FIRESTORE=true
FIREBASE_CREDENTIALS=serviceAccountKey.json
# On Vercel, paste the whole contents of the key file into FIREBASE_CREDENTIALS_JSON instead.

# --- shop ---
CURRENCY=INR
ADMIN_TOKEN=put-a-long-random-string-here
FREE_SHIPPING_OVER=0

# --- shipping by state ---
# Parcels to HOME_STATE cost SHIPPING_FEE, parcels to every other state cost SHIPPING_FEE_OTHER.
HOME_STATE=Karnataka
SHIPPING_FEE=150
SHIPPING_FEE_OTHER=350

# --- payments ---
# demo     = pretend payments, for testing
# razorpay = real payments (needs the two keys below)
PAYMENT_MODE=demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

CACHE_SECONDS=60

# --- alerts to you: every one of these is optional ---
# 1) Email. Contact-form messages and new orders both arrive here.
#    SMTP_PASSWORD is a Google "app password" (16 letters), NOT your normal Gmail password.
SMTP_USER=dcolorheist@gmail.com
SMTP_PASSWORD=
NOTIFY_EMAIL=dcolorheist@gmail.com

# 2) WhatsApp, through the free CallMeBot service. Phone in international form, e.g. +919876543210
WHATSAPP_PHONE=
CALLMEBOT_APIKEY=

# 3) Telegram (most dependable). Make a bot with @BotFather, then fill in both.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
